if not lib then return end

local Items = require 'modules.items.server'
local Inventory = require 'modules.inventory.server'
local TriggerEventHooks = require 'modules.hooks.server'
local Shops = {}
local locations = shared.target and 'targets' or 'locations'

---@class OxShopItem
---@field slot number
---@field weight number

local function setupShopItems(id, shopType, shopName, groups)
	local shop = id and Shops[shopType][id] or Shops[shopType] --[[@as OxShop]]

	for i = 1, shop.slots do
		local slot = shop.items[i]

		if slot.grade and not groups then
			print(('^1attempted to restrict slot %s (%s) to grade %s, but %s has no job restriction^0'):format(id, slot.name, json.encode(slot.grade), shopName))
			slot.grade = nil
		end

		local Item = Items(slot.name)

		if Item then
			local configuredPrice = tonumber(slot.price) or 0
			if configuredPrice ~= configuredPrice or configuredPrice < 0 then configuredPrice = 0 end
			configuredPrice = math.min(configuredPrice, 1000000000000)

			local configuredCount = slot.count
			if configuredCount ~= nil then
				configuredCount = tonumber(configuredCount)
				if not configuredCount or configuredCount ~= configuredCount then configuredCount = 0 end
				configuredCount = math.max(0, math.floor(configuredCount))
			end

			---@type OxShopItem
			slot = {
				name = Item.name,
				slot = i,
				weight = Item.weight,
				count = configuredCount,
				price = (server.randomprices and (not slot.currency or slot.currency == 'money')) and (math.ceil(configuredPrice * (math.random(80, 120)/100))) or configuredPrice,
				metadata = slot.metadata,
				license = slot.license,
				currency = slot.currency,
				grade = slot.grade
			}

			if slot.metadata then
				slot.weight = Inventory.SlotWeight(Item, slot, true)
			end

			shop.items[i] = slot
		end
	end
end

---@param shopType string
---@param properties OxShop
local function registerShopType(shopType, properties)
	local shopLocations = properties[locations] or properties.locations

	if shopLocations then
		Shops[shopType] = properties
	else
		Shops[shopType] = {
			label = properties.name,
			id = shopType,
			groups = properties.groups or properties.jobs,
			items = properties.inventory,
			slots = #properties.inventory,
			type = 'shop',
		}

		setupShopItems(nil, shopType, properties.name, properties.groups or properties.jobs)
	end
end

---@param shopType string
---@param id number
local function createShop(shopType, id)
	local shop = Shops[shopType]

	if not shop then return end

	local store = (shop[locations] or shop.locations)?[id]

	if not store then return end

	local groups = shop.groups or shop.jobs
    local coords

    if shared.target then
        if store.length then
            local z = store.loc.z + math.abs(store.minZ - store.maxZ) / 2
            coords = vec3(store.loc.x, store.loc.y, z)
        else
            coords = store.coords or store.loc
        end
    else
        coords = store
    end

	shop[id] = {
		label = shop.name,
		id = shopType..' '..id,
		groups = groups,
		items = table.clone(shop.inventory),
		slots = #shop.inventory,
		type = 'shop',
		coords = coords,
		distance = shared.target and shop.targets?[id]?.distance,
	}

	setupShopItems(id, shopType, shop.name, groups)

	return shop[id]
end

for shopType, shopDetails in pairs(lib.load('data.shops') or {}) do
	registerShopType(shopType, shopDetails)
end

---@param shopType string
---@param shopDetails OxShop
exports('RegisterShop', function(shopType, shopDetails)
	registerShopType(shopType, shopDetails)
end)

lib.callback.register('ox_inventory:openShop', function(source, data)
	local playerInv, shop = Inventory(source)

	if not playerInv then return end

	if data then
		if type(data) ~= 'table' or type(data.type) ~= 'string' then return end
		if data.id ~= nil and (type(data.id) ~= 'number' or data.id ~= data.id or data.id % 1 ~= 0 or data.id < 1 or data.id > 100000) then return end

		shop = Shops[data.type]

		if not shop then return end

		if not shop.items then
			shop = (data.id and shop[data.id] or createShop(data.type, data.id))

			if not shop then return end
		end

		---@cast shop OxShop

		if shop.groups then
			local group = server.hasGroup(playerInv, shop.groups)
			if not group then return end
		end

		if type(shop.coords) == 'vector3' then
			local ped = GetPlayerPed(source)
			if not ped or ped == 0 or not DoesEntityExist(ped) then return end
			local distance = math.max((tonumber(shop.distance) or 2.0) + 1.0, 3.0)
			if #(GetEntityCoords(ped) - shop.coords) > distance then return end
		end

		local shopType, shopId = shop.id:match('^(.-) (%d+)$')

        local hookPayload = {
            source = source,
            shopId = shopId or shop.id,
			shopType = shopType or shop.id,
            label = shop.label,
            slots = shop.slots,
            items = shop.items,
            groups = shop.groups,
            coords = shop.coords,
            distance = shop.distance
        }

        local hooks <close> = TriggerEventHooks('openShop', hookPayload)

		if not hooks.success then return end

		---@diagnostic disable-next-line: assign-type-mismatch
		playerInv:openInventory(playerInv)
		playerInv.currentShop = shop.id
	end

	return { label = playerInv.label, type = playerInv.type, slots = playerInv.slots, weight = playerInv.weight, maxWeight = playerInv.maxWeight }, shop
end)

local function canAffordItem(inv, currency, price)
	local canAfford = price >= 0 and Inventory.GetItemCount(inv, currency) >= price

	return canAfford or {
		type = 'error',
		description = locale('cannot_afford', ('%s%s'):format((currency == 'money' and locale('$') or math.groupdigits(price)), (currency == 'money' and math.groupdigits(price) or ' '..Items(currency).label)))
	}
end

local function removeCurrency(inv, currency, price)
	Inventory.RemoveItem(inv, currency, price)
end

local function isRequiredGrade(grade, rank)
	if type(rank) ~= 'number' then return false end

	if type(grade) == 'table' then
		for i = 1, #grade do
			if grade[i] == rank then return true end
		end
		return false
	end

	return type(grade) == 'number' and rank >= grade
end

local GetLocks = require 'modules.locks'

---@param source number
---@param playerInv OxInventory
---@param shop OxShop
---@return boolean
local function canAccessShop(source, playerInv, shop)
	if Inventory(source) ~= playerInv or playerInv.currentShop ~= shop.id then return false end
	if shop.groups and not server.hasGroup(playerInv, shop.groups) then return false end

	if type(shop.coords) == 'vector3' then
		local ped = GetPlayerPed(source)
		if not ped or ped == 0 or not DoesEntityExist(ped) then return false end
		local distance = math.max((tonumber(shop.distance) or 2.0) + 1.0, 3.0)
		if #(GetEntityCoords(ped) - shop.coords) > distance then return false end
	end

	return true
end

local function restorePurchaseSnapshot(inv, items, weight, changed)
	inv.items = items
	inv.weight = weight
	inv.changed = changed

	local updates = {}
	for slot = 1, inv.slots do
		updates[#updates + 1] = { item = inv.items[slot] or { slot = slot }, inventory = inv.id }
	end
	inv:syncSlotsWithClients(updates, true)
	if server.syncInventory then server.syncInventory(inv) end
end

lib.callback.register('ox_inventory:buyItem', function(source, data)
	if type(data) ~= 'table'
		or data.toType ~= 'player'
		or type(data.fromSlot) ~= 'number' or data.fromSlot ~= data.fromSlot or data.fromSlot % 1 ~= 0 or data.fromSlot < 1 or data.fromSlot > 100000
		or type(data.toSlot) ~= 'number' or data.toSlot ~= data.toSlot or data.toSlot % 1 ~= 0 or data.toSlot < 1 or data.toSlot > 100000
		or type(data.count) ~= 'number' or data.count ~= data.count or data.count <= 0 or data.count > 1000000 then
		return
	end

	local playerInv = Inventory(source)
	if not playerInv or type(playerInv.currentShop) ~= 'string' or data.toSlot > playerInv.slots then return end

	local shopType, shopId = playerInv.currentShop:match('^(.-) (%d+)$')
	if not shopType then shopType = playerInv.currentShop end
	shopId = shopId and tonumber(shopId) or nil

	local shopRoot = Shops[shopType]
	local shop = shopId and shopRoot and shopRoot[shopId] or shopRoot
	if not shop or not shop.items or shop.id ~= playerInv.currentShop then return end
	if data.fromSlot > shop.slots or not canAccessShop(source, playerInv, shop) then
		playerInv:closeInventory()
		return
	end

	-- Serialize stock and the full player inventory. Purchases are short transactions,
	-- and locking the complete inventory closes currency/destination races cleanly.
	local lockIds = { ('shop-%s:slot-%s'):format(shop.id, data.fromSlot) }
	for slot = 1, playerInv.slots do
		lockIds[#lockIds + 1] = ('inventory-%s:slot-%s'):format(playerInv.id, slot)
	end
	local activeSlots <close> = GetLocks(lockIds)
	if not activeSlots then return end

	if not canAccessShop(source, playerInv, shop) then
		playerInv:closeInventory()
		return
	end

	local fromData = shop.items[data.fromSlot]
	if not fromData then return end

	local requestedCount = math.max(1, math.floor(data.count))
	if fromData.count ~= nil then
		if fromData.count < 1 then
			return false, false, { type = 'error', description = locale('shop_nostock') }
		end
		requestedCount = math.min(requestedCount, fromData.count)
	end

	if fromData.license and server.hasLicense and not server.hasLicense(playerInv, fromData.license) then
		return false, false, { type = 'error', description = locale('item_unlicensed') }
	end

	if fromData.grade then
		local _, rank = server.hasGroup(playerInv, shop.groups)
		if not isRequiredGrade(fromData.grade, rank) then
			return false, false, { type = 'error', description = locale('stash_lowgrade') }
		end
	end

	local currency = fromData.currency or 'money'
	local currencyItem = Items(currency)
	local fromItem = Items(fromData.name)
	if not fromItem or not currencyItem then return end

	local result = fromItem.cb and fromItem.cb('buying', fromItem, playerInv, data.fromSlot, shop)
	if result == false or Inventory(source) ~= playerInv or not canAccessShop(source, playerInv, shop) then return false end

	local metadata, count = Items.Metadata(playerInv, fromItem, fromData.metadata and table.clone(fromData.metadata) or {}, requestedCount)
	if type(count) ~= 'number' or count ~= count then return end
	count = math.floor(count)
	if count < 1 or count > requestedCount then return end
	if fromData.count ~= nil and count > fromData.count then
		return false, false, { type = 'error', description = locale('shop_nostock') }
	end

	local price = count * fromData.price
	if price ~= price or price < 0 or price > 1000000000000000 then return end

	local toData = playerInv.items[data.toSlot]
	local toItem = toData and Items(toData.name)
	if toData ~= nil and not (fromItem.name == toItem?.name and fromItem.stack and table.matches(toData.metadata, metadata)) then
		return false, false, { type = 'error', description = locale('unable_stack_items') }
	end

	local canAfford = canAffordItem(playerInv, currency, price)
	if canAfford ~= true then return false, false, canAfford end

	local hooks <close> = TriggerEventHooks('buyItem', {
		source = source,
		shopType = shopType,
		shopId = shopId,
		toInventory = playerInv.id,
		toSlot = data.toSlot,
		fromSlot = fromData,
		itemName = fromData.name,
		metadata = metadata,
		count = count,
		price = fromData.price,
		totalPrice = price,
		currency = currency,
	})
	if not hooks.success then return false end
	if Inventory(source) ~= playerInv or not canAccessShop(source, playerInv, shop) then hooks.success = false return false end

	-- Hooks may yield; reread stock and funds after they return while locks are still held.
	fromData = shop.items[data.fromSlot]
	if not fromData or (fromData.count ~= nil and fromData.count < count) then
		hooks.success = false
		return false, false, { type = 'error', description = locale('shop_nostock') }
	end
	canAfford = canAffordItem(playerInv, currency, price)
	if canAfford ~= true then hooks.success = false return false, false, canAfford end

	local snapshotItems = table.deepclone(playerInv.items)
	local snapshotWeight = playerInv.weight
	local snapshotChanged = playerInv.changed
	local stockBefore = fromData.count

	local committed, commitError = xpcall(function()
		local ok = Inventory.SetSlot(playerInv, fromItem, count, metadata, data.toSlot)
		if not ok then error('purchase destination insertion failed') end
		if playerInv.weight > playerInv.maxWeight then error('purchase exceeds inventory weight') end

		if price > 0 then
			local removed = Inventory.RemoveItem(playerInv, currency, price)
			if not removed then error('purchase currency removal failed') end
		end

		if fromData.count ~= nil then fromData.count -= count end
	end, debug.traceback)

	if not committed then
		hooks.success = false
		fromData.count = stockBefore
		restorePurchaseSnapshot(playerInv, snapshotItems, snapshotWeight, snapshotChanged)
		lib.print.error(('Shop transaction rolled back for player %s: %s'):format(source, tostring(commitError)))
		return false
	end

	if server.syncInventory then server.syncInventory(playerInv) end

	local message = locale('purchased_for', count, metadata?.label or fromItem.label,
		(currency == 'money' and locale('$') or math.groupdigits(price)),
		(currency == 'money' and math.groupdigits(price) or ' '..currencyItem.label))

	if server.loglevel > 0 and (server.loglevel > 1 or fromData.price >= 500) then
		lib.logger(playerInv.owner, 'buyItem', ('"%s" %s'):format(playerInv.label, message:lower()), ('shop:%s'):format(shop.label))
	end

	return true, { data.toSlot, playerInv.items[data.toSlot], fromData.count ~= nil and fromData or false, playerInv.weight },
		{ type = 'success', description = message }
end)

server.shops = Shops
